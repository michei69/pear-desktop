{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 140,
  "tabWidth": 2,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "quoteProps": "preserve",
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "coverage/",
    "nub.lock",
    "changelog.md",
    "**/*.d.ts",
    "out/",
    "pack/",
    "**/*.json"
  ]
}
