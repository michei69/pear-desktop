{
  "name": "pear-desktop",
  "private": true,
  "type": "module",
  "version": "4.0.0",
  "description": "\u0059\u006f\u0075\u0054\u0075\u0062\u0065\u0020\u004d\u0075\u0073\u0069\u0063 Desktop App - including custom plugins",
  "license": "MIT",
  "repository": "michei69/pear-desktop",
  "author": {
    "name": "th-ch",
    "email": "th-ch@users.noreply.github.com",
    "url": "https://github.com/pear-devs/pear-desktop"
  },
  "contributors": [
    {
      "name": "Mikey",
      "email": "76266972+michei69@users.noreply.github.com",
      "url": "https://github.com/michei69/pear-desktop"
    }
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.ts",
    "dev": "nub run --filter @pear/desktop dev",
    "build": "nub run --filter @pear/desktop build",
    "start": "nub run --filter @pear/desktop start",
    "clean": "nub run --filter @pear/desktop clean",
    "typecheck": "nub run -r typecheck",
    "test": "nub run -r test",
    "test:e2e": "nub run --filter @pear/desktop test:e2e",
    "i18n": "nub run --filter @pear/desktop i18n",
    "dist": "nub run --filter @pear/desktop dist",
    "dist:linux": "nub run --filter @pear/desktop dist:linux",
    "dist:linux:deb-arm64": "nub run --filter @pear/desktop dist:linux:deb-arm64",
    "dist:linux:rpm-arm64": "nub run --filter @pear/desktop dist:linux:rpm-arm64",
    "dist:mac": "nub run --filter @pear/desktop dist:mac",
    "dist:mac:arm64": "nub run --filter @pear/desktop dist:mac:arm64",
    "dist:win": "nub run --filter @pear/desktop dist:win",
    "dist:win:x64": "nub run --filter @pear/desktop dist:win:x64",
    "beta:linux": "nub run --filter @pear/desktop beta:linux",
    "beta:mac": "nub run --filter @pear/desktop beta:mac",
    "beta:win": "nub run --filter @pear/desktop beta:win",
    "release:linux": "nub run --filter @pear/desktop release:linux",
    "release:mac": "nub run --filter @pear/desktop release:mac",
    "release:win": "nub run --filter @pear/desktop release:win",
    "lint": "oxlint --type-aware apps packages plugins src",
    "format": "oxfmt --write apps packages plugins src scripts",
    "format:check": "oxfmt --check apps packages plugins src scripts",
    "changelog": "nub run dlx auto-changelog"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-solid": "0.14.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "^7.0.2"
  },
  "auto-changelog": {
    "hideCredit": true,
    "package": true,
    "unreleased": true,
    "output": "changelog.md",
    "tagPattern": "^v\\d+\\.\\d+\\.\\d+$"
  }
}
