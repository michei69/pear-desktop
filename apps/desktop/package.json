{
  "name": "@pear/desktop",
  "productName": "\u0059\u006f\u0075\u0054\u0075\u0062\u0065\u0020\u004d\u0075\u0073\u0069\u0063",
  "version": "4.0.0",
  "description": "\u0059\u006f\u0075\u0054\u0075\u0062\u0065\u0020\u004d\u0075\u0073\u0069\u0063 Desktop App - including custom plugins",
  "author": {
    "name": "th-ch",
    "email": "th-ch@users.noreply.github.com",
    "url": "https://github.com/pear-devs/pear-desktop"
  },
  "contributors": [
    {
      "name": "Mikey",
      "email": "76266972+michei69@users.noreply.github.com",
      "url": "https://github.com/michei69/pear-desktop"
    }
  ],
  "license": "MIT",
  "repository": "michei69/pear-desktop",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "clean": "del-cli out ../../pack",
    "typecheck": "tsc -p .",
    "test:e2e": "electron-vite build && playwright test",
    "test": "vitest run",
    "i18n": "node scripts/i18n.ts",
    "dist": "electron-vite build && electron-builder --win --mac --linux -p never",
    "dist:linux": "electron-vite build && electron-builder --linux -p never",
    "dist:linux:deb-arm64": "electron-vite build && electron-builder --linux deb:arm64 -p never",
    "dist:linux:rpm-arm64": "electron-vite build && electron-builder --linux rpm:arm64 -p never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg:x64 -p never",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac dmg:arm64 -p never",
    "dist:win": "electron-vite build && electron-builder --win -p never",
    "dist:win:x64": "electron-vite build && electron-builder --win nsis-web:x64 -p never",
    "beta:linux": "electron-vite build && electron-builder --linux -p never -c.publish.provider=github -c.publish.channel=beta",
    "beta:mac": "electron-vite build && electron-builder --mac -p never -c.publish.provider=github -c.publish.channel=beta",
    "beta:win": "electron-vite build && electron-builder --win -p never -c.publish.provider=github -c.publish.channel=beta",
    "release:linux": "electron-vite build && electron-builder --linux -p never -c.publish.provider=github",
    "release:mac": "electron-vite build && electron-builder --mac -p never -c.publish.provider=github",
    "release:win": "electron-vite build && electron-builder --win -p never -c.publish.provider=github"
  },
  "devDependencies": {
    "@jellybrick/dbus-next": "^0.11.4",
    "@pear/page": "workspace:*",
    "@pear/sdk": "workspace:*",
    "@pear/vite-plugin": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "del-cli": "7.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@michei69/node-smtc": "workspace:*"
  }
}
